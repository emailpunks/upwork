# Copy this file to pods.secrets.yaml (gitignored, never commit it) and fill
# in the value below for local runs.
#
# In CI, the same value is supplied as a NOTION_TOKEN GitHub Actions secret
# instead, and this file isn't needed.
#
# notion_token: an internal integration token from notion.so/my-integrations,
# shared with every database referenced in pods.yaml (via each database's
# "..." menu -> Connections).

notion_token: "secret_..."
