# Copy this file to pods.secrets.yaml (gitignored, never commit it) and fill
# in the values below for local runs.
#
# In CI, the same values are supplied as GitHub Actions secrets instead
# (UPWORK_CLIENT_ID, UPWORK_CLIENT_SECRET, UPWORK_REFRESH_TOKEN,
# UPWORK_ORGANIZATION_ID, NOTION_TOKEN) and this file isn't needed.
#
# - upwork_client_id / upwork_client_secret: from the app registered at
#   upwork.com/developer/keys/apply.
# - upwork_refresh_token: from a one-time run of scripts/upwork_authorize.py
#   (see README.md).
# - upwork_organization_id: Email Punks' Upwork organization ID (the
#   `organizationId_eq` value every timeReport query is scoped to).
# - notion_token: an internal integration token from notion.so/my-integrations,
#   shared with every database referenced in pods.yaml.

upwork_client_id: "..."
upwork_client_secret: "..."
upwork_refresh_token: "..."
upwork_organization_id: "..."
notion_token: "secret_..."
